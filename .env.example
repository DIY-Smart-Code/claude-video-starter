# ElevenLabs (step 5). Copy this file to .env and fill it in:  cp .env.example .env
# The key lives here, never in a prompt or a screenshot. .env is gitignored.
# Any voice from the ElevenLabs voice library works. The tutorial's examples use the
# stock voice Sarah: EXAVITQu4vr4xnSDxMaL
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4

# Optional voice settings. Leave them commented out to use the voice's own defaults.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_USE_SPEAKER_BOOST=true
# ELEVENLABS_SPEED=1.0
# ELEVENLABS_SPEED_SHORTS=1.1      # used instead of SPEED for vertical videos (Shorts, Reels)
# Optional pronunciation dictionary; both IDs are needed.
# ELEVENLABS_PRONUNCIATION_DICT_ID=
# ELEVENLABS_PRONUNCIATION_DICT_VERSION_ID=
